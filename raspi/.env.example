# Copy this file to .env and fill in real values. Never commit the real .env.

### Global ###
TZ=Europe/Lisbon
DOMAIN_BASE=home.arpa
# City used by the Glance weather panel (Open-Meteo geocoding). "City,CC" works.
WEATHER_LOCATION=Lisbon,PT

### Network ###
# Used by scripts/08_setup-firewall.sh to scope SSH/HTTP(S) access to your LAN.
LOCAL_SUBNET=192.168.1.0/24
# Auto-detected by 02_setup-lan-ip.sh / 01_setup.sh. Seeds Pi-hole's Local DNS
# Records for every *.home.arpa hostname, so you never add them by hand.
SERVER_LAN_IP=

### Traefik ###
# Generate with: htpasswd -nbB admin 'yourpassword' (needs apache2-utils).
# Protects the Traefik dashboard. Escape $ as $$ in .env files.
TRAEFIK_DASHBOARD_AUTH=

### Vaultwarden ###
PG_USER=admin
PG_PASSWORD=change-me-strong-password
VAULTWARDEN_ADMIN_TOKEN=change-me-generate-with-openssl-rand-base64-48
VAULTWARDEN_JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

### OctoPrint ###
OCTOPRINT_USER=admin
OCTOPRINT_PASS=change-me

### Pi-hole ###
PIHOLE_PASSWORD=change-me
# Upstream DNS resolvers Pi-hole forwards non-blocked queries to
PIHOLE_UPSTREAM_DNS_1=1.1.1.1
PIHOLE_UPSTREAM_DNS_2=1.0.0.1
# DHCP range Pi-hole will serve (only if you disable your router's DHCP)
PIHOLE_DHCP_START=192.168.1.100
PIHOLE_DHCP_END=192.168.1.250
PIHOLE_DHCP_ROUTER=192.168.1.1
PIHOLE_DHCP_NETMASK=255.255.255.0
# Pi-hole runs with network_mode: host, so it's reachable at the Pi's own
# LAN IP - same as everything else behind Traefik. No separate IP needed.

### Nextcloud ###
NEXTCLOUD_DB_PASSWORD=admin
NEXTCLOUD_DB_ROOT_PASSWORD=change-me
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=change-me

### Scheduler Discord bot ###
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
BOT_TOKEN=your-discord-bot-token
BOT_DATABASE_URL=sqlite:////app/db/scheduler.db
BOT_ENVIRONMENT=production
BOT_LOG_LEVEL=INFO

### Tailscale ###
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Short-lived, read-only Tailscale API key; rotate it before expiry.
TAILSCALE_API_KEY=tskey-api-...
# Optional: added as a cert SAN so HTTPS validates over the raw Tailscale IP.
TAILSCALE_IP=

### Authentik (single sign-on) ###
# Pin the tag: Authentik's DB migrations are one-way, so a surprise major bump
# from :latest can leave you unable to roll back.
AUTHENTIK_TAG=2026.8.0
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=change-me-generate-with-openssl-rand-base64-60
# The first admin account is created in the browser at the initial-setup flow.

### Immich (photos) ###
# Pin the major version; "release" occasionally needs a manual migration.
IMMICH_VERSION=v3
# Alphanumeric only - Immich builds a connection string from it.
IMMICH_DB_PASSWORD=change-me-alphanumeric-only
# Host path for the photo/video library. Bind mount (not a volume) so you can
# point it at an external disk and back it up with normal file tools.
# scripts/01_setup.sh creates this directory if it doesn't exist.
IMMICH_UPLOAD_LOCATION=/srv/media/immich
IMMICH_URL=http://immich-server:2283
IMMICH_KEY=replace-with-an-Immich-key-with-server.statistics-and-server.storage

### Jellyfin (media) ###
# Host path holding your media, mounted read-write at /media in the container.
# Organise it as /movies, /shows, /music subfolders and add those as libraries.
JELLYFIN_MEDIA_PATH=/srv/media/jellyfin
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_KEY=replace-with-a-Jellyfin-dashboard-API-key
JELLYFIN_USER=replace-with-your-Jellyfin-user-name

### Stirling PDF ###
STIRLING_LOCALE=en-GB

### Minecraft server ###
# Must be TRUE (accept Mojang's EULA) or the server refuses to start.
MINECRAFT_EULA=FALSE
# VANILLA, PAPER, FABRIC, FORGE, ... PAPER is the usual pick on low-power hardware.
MINECRAFT_TYPE=PAPER
# LATEST, or pin one like 1.21.4.
MINECRAFT_VERSION=LATEST
# INIT is claimed at startup; MAX is the ceiling it may grow to. Keeping INIT
# low stops an idle server holding the full ceiling in RAM.
MINECRAFT_INIT_MEMORY=512M
MINECRAFT_MAX_MEMORY=2G
MINECRAFT_DIFFICULTY=normal
MINECRAFT_MAX_PLAYERS=10
MINECRAFT_MOTD=Homelab Minecraft Server
# Comma-separated Minecraft usernames. OPS get admin commands; WHITELIST is
# who may join (the whitelist is enabled by default in compose).
MINECRAFT_OPS=
MINECRAFT_WHITELIST=

### ONLYOFFICE Document Server ###
# Shared secret ONLYOFFICE uses to authenticate callers (JWT). It's enabled by
# default with a random secret, which would be impossible to pair with
# Nextcloud - pin it here. The same value goes into Nextcloud's connector.
#   openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

### Beszel (system monitoring) ###
# Leave the blank values alone: scripts/03_setup-beszel.sh pre-generates the
# hub's SSH key and a registration token so the agent self-registers, and
# re-running it never rotates existing values.
BESZEL_SYSTEM_NAME=raspi
BESZEL_URL=http://beszel:8090
# Set this to the email of a regular Beszel account after first login; the
# script then assigns the preconfigured system to that account.
BESZEL_SYSTEM_USER=
# Agent registration token (see scripts/03_setup-beszel.sh). Used by the
# agent to authenticate to the hub; NOT accepted by the REST API.
BESZEL_TOKEN=
BESZEL_KEY=
# Long-lived PocketBase user auth JWT for Glance's Beszel widget. Unlike the
# agent token above, this one authenticates REST /api/collections/* calls and
# must be minted for the account that owns the system. See the comment in
# glance/widgets/beszel-resources.yml for how to generate/renew it.
BESZEL_USER_TOKEN=

### Authentik SSO integrations ###
# Generated by scripts/04_setup-authentik.sh: created on the authentik side by
# the blueprint, and pasted into each app. Leave blank; the script fills them
# in without overwriting existing values.
IMMICH_OIDC_CLIENT_ID=
IMMICH_OIDC_CLIENT_SECRET=
NEXTCLOUD_OIDC_CLIENT_ID=
NEXTCLOUD_OIDC_CLIENT_SECRET=
JELLYFIN_OIDC_CLIENT_ID=
JELLYFIN_OIDC_CLIENT_SECRET=
BESZEL_OIDC_CLIENT_ID=
BESZEL_OIDC_CLIENT_SECRET=

### AI assistant (Ollama + Open WebUI) ###
# Model pulled by scripts/07_setup-ai.sh and served by Ollama. This is a
# CPU-only Pi, so keep it small: qwen3:1.7b is a good balance of quality and
# speed, qwen3:0.6b is much lighter, and qwen2.5:1.5b is a solid alternative.
# Switching models later: edit this, re-run scripts/07_setup-ai.sh, then pick
# the new model in Open WebUI.
OLLAMA_MODEL=qwen3:1.7b
# Leave blank: scripts/07_setup-ai.sh generates it. Open WebUI signs sessions
# with it and encrypts stored secrets, so it must be set and must stay stable
# once the stack has been used.
OPENWEBUI_SECRET_KEY=

### TLS certificate renewal ###
# The cert-renew service reissues the leaf once it has fewer than this many
# days left. It checks daily, so 30 gives ~30 chances to succeed. The root CA
# is never touched, so renewals need no action on your devices.
CERT_RENEW_BEFORE_DAYS=30
