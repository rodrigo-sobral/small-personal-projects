.env
traefik/certs/
# Written by scripts/maintenance/renew-certs.sh purely to trigger a Traefik config reload
traefik/dynamic/cert-reload.yml
# Generated by scripts/05_setup-ca.sh and served by Glance at /assets/.
# The i18n files are hand-authored, so keep them tracked.
glance/assets/*
!glance/assets/i18n.js
!glance/assets/i18n.css
!glance/assets/theme-order.js
!glance/assets/weather-panel.js
# Generated by scripts/03_setup-beszel.sh: the hub's SSH identity and the
# declared system (which embeds the agent's registration token)
beszel/id_ed25519
beszel/id_ed25519.pub
beszel/config.yml
